generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Dashboard {
  id          String   @id @default(uuid())
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  links       Link[]
}

model Link {
  id          String    @id @default(uuid())
  title       String
  description String?
  url         String
  position    Int
  iconKey     String?
  badge       String?
  dashboardId String
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([dashboardId, position])
}

model IconIndex {
  id        String   @id @default(uuid())
  name      String
  path      String   @unique
  createdAt DateTime @default(now())
}